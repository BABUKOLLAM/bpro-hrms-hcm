<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_bpro_hcm_dashboard_form" model="ir.ui.view">
        <field name="name">bpro.hcm.dashboard.form</field>
        <field name="model">bpro.hcm.dashboard</field>
        <field name="arch" type="xml">
            <form class="o_form_nosheet">
                <field name="currency_id" invisible="1"/>
                <div class="d-flex justify-content-between align-items-center flex-wrap p-3">
                    <h1>bpro HCM Dashboard</h1>
                    <div>
                        <label for="as_of_date" string="As of" class="me-2"/>
                        <field name="as_of_date" class="d-inline-block"/>
                    </div>
                </div>

                <div class="row g-3 p-3">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Payroll</div>
                                <h2 class="mb-0"><field name="payroll_mtd_gross" widget="monetary" nolabel="1"/></h2>
                                <div class="small">Gross Payout (MTD)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Payroll</div>
                                <h2 class="mb-0"><field name="payroll_pending_confirmation" nolabel="1"/></h2>
                                <div class="small">Payslips Pending Confirmation</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Recruitment</div>
                                <h2 class="mb-0"><field name="recruitment_open_vacancies" nolabel="1"/></h2>
                                <div class="small">Open Vacancies</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Recruitment</div>
                                <h2 class="mb-0"><field name="recruitment_overdue_joining_reports" nolabel="1"/></h2>
                                <div class="small">Overdue Joining Reports</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-secondary text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Attendance</div>
                                <h2 class="mb-0"><field name="attendance_pending_exceptions" nolabel="1"/></h2>
                                <div class="small">Pending Absence Reviews</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-dark text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Separation</div>
                                <h2 class="mb-0"><field name="exit_open_requests" nolabel="1"/></h2>
                                <div class="small">Open Exit Requests</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-danger text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Separation</div>
                                <h2 class="mb-0"><field name="attrition_rate_pct" nolabel="1"/>%</h2>
                                <div class="small">Attrition (Trailing 12M)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white h-100">
                            <div class="card-body">
                                <div class="text-uppercase small opacity-75">Leave</div>
                                <h2 class="mb-0"><field name="el_liability" widget="monetary" nolabel="1"/></h2>
                                <div class="small">EL Encashment Liability</div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="action_bpro_hcm_dashboard" model="ir.actions.act_window">
        <field name="name">HCM Dashboard</field>
        <field name="res_model">bpro.hcm.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_bpro_hcm_dashboard_root" name="Human Resources" sequence="1"/>
    <menuitem id="menu_bpro_hcm_dashboard" name="Dashboard"
              parent="menu_bpro_hcm_dashboard_root"
              action="action_bpro_hcm_dashboard" sequence="1"/>

</odoo>
